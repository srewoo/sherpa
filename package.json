{
  "name": "sherpa",
  "version": "0.2",
  "description": "Local-first help-site answer engine \u2014 a Chrome MV3 extension that crawls a documentation site, indexes it in the browser, and answers questions from that index with zero servers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite",
    "build": "node scripts/copy-ort.mjs && tsc --noEmit && vite build && node scripts/verify-bundle.mjs && node scripts/package.mjs",
    "fetch:model": "node scripts/fetch-model.mjs",
    "bench": "vitest run --config vitest.bench.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "assets": "node scripts/render-assets.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "shots:fit": "node scripts/fit-screenshots.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "fetch:reranker": "node scripts/fetch-reranker.mjs",
    "eval:corpus": "vitest run --config vitest.eval.config.ts src/eval/buildCorpus.eval.ts",
    "eval:fixture": "vitest run --config vitest.eval.config.ts src/eval/fixtureExport.eval.ts",
    "eval:sites": "vitest run --config vitest.eval.config.ts src/eval/multiSite.eval.ts",
    "eval:rerank": "vitest run --config vitest.eval.config.ts src/eval/rerankAblation.eval.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@xenova/transformers": "^2.17.2",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}